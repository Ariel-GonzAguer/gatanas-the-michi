# Gatanás The Michi — ejemplo de entorno
# Copiá esto a tu Sprite y ajustá. Nada de esto es secreto salvo SPRITES_TOKEN.

PORT=8080
SPRITE_NAME=gatanas-the-michi
GATANAS_HOME=/home/sprite/.gatanas
OPENROUTER_CONNECTION=BQCIyKoHE5fYfVaZy5gDbg
GATANAS_MODEL_DIET=z-ai/glm-5.3-flash
GATANAS_MODEL_MEOW=z-ai/glm-5.3-flash
GATANAS_MODEL_CHAT=google/gemma-4-31b-it:free
GATANAS_MODEL_CHAT_FALLBACKS=nvidia/nemotron-3.5-lightning:free,z-ai/glm-5.3-flash
GATANAS_MODEL_DIGEST=z-ai/glm-5.3-flash
GATANAS_HUNT_INTERVAL_SEC=900
GATANAS_DAILY_BUDGET_USD=0.5
GATANAS_DAILY_TOKEN_BUDGET=40000
GATANAS_LIVES=9
# SPRITES_TOKEN=...  # opcional: solo vidas y servicios
